{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/admin/portfolio/clients/:clientId", "destination": "/api/index?route=/api/admin/portfolio/clients/:clientId" },
    { "source": "/api/about/founder-image", "destination": "/api/index?route=/api/about/founder-image" },
    { "source": "/api/admin/:path*", "destination": "/api/index?route=/api/admin/:path*" },
    { "source": "/api/contact-card/profile", "destination": "/api/index?route=/api/contact-card/profile" },
    { "source": "/api/contact-buttons", "destination": "/api/index?route=/api/contact-buttons" },
    { "source": "/api/health", "destination": "/api/index?route=/api/health" },
    { "source": "/api/performance-details", "destination": "/api/index?route=/api/performance-details" },
    { "source": "/api/portfolio", "destination": "/api/index?route=/api/portfolio" },
    { "source": "/api/settings/contact", "destination": "/api/index?route=/api/settings/contact" },
    { "source": "/api/settings/socials", "destination": "/api/index?route=/api/settings/socials" },
    { "source": "/admin/login", "destination": "/admin/login/index.html" },
    { "source": "/about-us", "destination": "/index.html" },
    { "source": "/packages", "destination": "/index.html" },
    { "source": "/performance", "destination": "/index.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy-policy", "destination": "/index.html" },
    { "source": "/risk-policy", "destination": "/index.html" },
    { "source": "/terms-conditions", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
